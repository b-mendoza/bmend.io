{
  "name": "bmendoza-io",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix build",
    "clean:hard": "rimraf --verbose .wrangler functions node_modules pnpm-lock.yaml public/build tsconfig.tsbuildinfo",
    "clean:soft": "rimraf --verbose .wrangler functions node_modules/.cache public/build tsconfig.tsbuildinfo",
    "dev": "remix dev --manual -c \"pnpm run start\"",
    "fix": "concurrently --kill-others-on-fail --prefix-colors \"auto\" \"pnpm:fix:*\"",
    "fix:eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint --fix .",
    "fix:prettier": "prettier --ignore-unknown --cache --write .",
    "lint": "concurrently --prefix-colors \"auto\" \"pnpm:lint:*\"",
    "lint:eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:prettier": "prettier --ignore-unknown --cache --check .",
    "lint:types": "tsc --pretty",
    "prepare": "husky",
    "start": "wrangler pages dev --compatibility-date=2024-02-07 ./public"
  },
  "dependencies": {
    "@radix-ui/react-toggle": "1.1.16",
    "@remix-run/cloudflare": "2.6.0",
    "@remix-run/cloudflare-pages": "2.6.0",
    "@remix-run/react": "2.17.3",
    "@unpic/react": "0.1.15",
    "clsx": "2.1.1",
    "dayjs": "1.11.20",
    "hono": "3.12.12",
    "isbot": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remix-hono": "0.0.15",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260517.1",
    "@remix-run/dev": "2.6.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "autoprefixer": "10.5.4",
    "concurrently": "9.2.4",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-love": "43.1.0",
    "eslint-plugin-deprecation": "3.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-sonarjs": "0.25.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "postcss": "8.5.22",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "wrangler": "3.114.17"
  },
  "packageManager": "pnpm@8.15.9+sha256.daa27a0b541bc635323ff96c2ded995467ff9fe6d69ff67021558aa9ad9dcc36",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  }
