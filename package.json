{
  "name": "bmendoza-io",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean:hard": "rimraf --verbose .wrangler dist .tanstack node_modules pnpm-lock.yaml tsconfig.tsbuildinfo",
    "clean:soft": "rimraf --verbose .wrangler dist .tanstack node_modules/.cache tsconfig.tsbuildinfo",
    "dev": "vite",
    "fix": "concurrently --kill-others-on-fail --prefix-colors \"auto\" \"pnpm:fix:*\"",
    "fix:eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint --fix .",
    "fix:prettier": "prettier --ignore-unknown --cache --write .",
    "lint": "concurrently --prefix-colors \"auto\" \"pnpm:lint:*\"",
    "lint:eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:prettier": "prettier --ignore-unknown --cache --check .",
    "lint:types": "tsc --pretty",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "vite preview",
    "test": "node --test test/smoke.test.mjs"
  },
  "dependencies": {
