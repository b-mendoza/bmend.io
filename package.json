{
  "name": "bmendoza-io",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix build",
    "clean:hard": "rimraf --verbose .wrangler functions node_modules pnpm-lock.yaml public/build tsconfig.tsbuildinfo",
    "clean:soft": "rimraf --verbose .wrangler functions node_modules/.cache public/build tsconfig.tsbuildinfo",
    "dev": "remix dev --manual -c \"pnpm run start\"",
    "fix": "concurrently --kill-others-on-fail --prefix-colors \"auto\" \"pnpm:fix:*\"",
    "fix:eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint --fix .",
    "fix:prettier": "prettier --ignore-unknown --cache --write .",
    "lint": "concurrently --prefix-colors \"auto\" \"pnpm:lint:*\"",
    "lint:eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:prettier": "prettier --ignore-unknown --cache --check .",
    "lint:types": "tsc --pretty",
    "prepare": "husky",
    "start": "wrangler pages dev --compatibility-date=2024-02-07 ./public"
  },
  "dependencies": {
    "@radix-ui/react-toggle": "1.0.3",
    "@remix-run/cloudflare": "2.6.0",
    "@remix-run/cloudflare-pages": "2.6.0",
    "@remix-run/react": "2.17.3",
    "@unpic/react": "0.1.9",
    "clsx": "2.1.0",
    "dayjs": "1.11.10",
    "hono": "3.12.12",
    "isbot": "4.4.0",
    "react": "18.3.0-canary-2cd19ed1d-20240207",
    "react-dom": "18.3.0-canary-2cd19ed1d-20240207",
    "remix-hono": "0.0.15",
    "tailwind-merge": "2.2.1",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260316.1",
    "@remix-run/dev": "2.6.0",
    "@total-typescript/ts-reset": "0.5.1",
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.19",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "autoprefixer": "10.4.27",
    "concurrently": "8.2.2",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-config-love": "43.1.0",
    "eslint-plugin-deprecation": "2.0.0",
